  { kind: 'cloud', id: 'siliconflow', label: '硅基流动', url: 'https://api.siliconflow.cn', api: 'anthropic-messages' },
  { kind: 'cloud', id: 'minimax', label: 'MiniMax', url: 'https://api.minimaxi.com/anthropic', api: 'anthropic-messages' },
  { kind: 'cloud', id: 'anthropic', label: 'Anthropic 官方', url: 'https://api.anthropic.com', api: 'anthropic-messages' },
]

async function apiApply(body) {
  const mode = clean(body.mode || 'set')
  const args = []
  const steps = []
  if (mode === 'clear') {
    args.push('--clear')
  } else {
    const preset = clean(body.preset)
    const baseUrl = clean(body.baseUrl)
    const api = clean(body.api || 'anthropic-messages')
    const providerId = clean(body.providerId || 'gateway', 64)
    const keyVar = clean(body.keyVar, 64)
    const models = (Array.isArray(body.models) ? body.models : String(body.models || '').split(','))
      .map((m) => clean(m, 256)).filter(Boolean)
    const key = String(body.key || '').replace(/[\r\n]/g, '')
    if (api !== 'anthropic-messages' && api !== 'openai-completions') {
      return { ok: false, out: '不支持的协议：' + api }
    }
    if (!models.length) return { ok: false, out: '至少要给一个模型 id' }
    if (preset) args.push(preset)
    else if (baseUrl) args.push('--base-url', baseUrl)
    else return { ok: false, out: '缺少端点：给预置名或填 baseURL' }
    args.push('--api', api)
    if (api === 'openai-completions') args.push('--provider-id', providerId)
    if (keyVar) args.push('--key-var', keyVar)
    args.push('--model', models.join(','))
    if (body.maxTokens) args.push('--max-tokens', String(Number(body.maxTokens) || 8192))
    if (body.contextWindow) args.push('--context-window', String(Number(body.contextWindow) || 131072))
    if (body.thinking) args.push('--thinking')
    if (key) args.push('--key', key)
    args.push('--no-restart')
  }
  const r = await runFile(BIN + '/dsh-set-provider', args, 180000)
  steps.push({ cmd: 'dsh-set-provider ' + args.map((a) => (a === String(body.key || '') && body.key ? '****' : a)).join(' '), code: r.code, out: r.out })
  if (r.code !== 0) return { ok: false, steps, out: r.out }
  if (body.restart !== false) {
    const rr = await runFile(BIN + '/sv', ['restart', 'dsh-web'], 30000)
    await sleep(4000)
    const sr = await runFile(BIN + '/sv', ['status', 'dsh-web'], 10000)
    steps.push({ cmd: 'sv restart dsh-web', code: rr.code, out: sr.out })
  }
  return { ok: true, steps, state: await buildState() }
}

async function apiKey(body) {
  const name = clean(body.name, 64)
  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)) return { ok: false, out: '变量名不合法' }
  const args = []
  if (body.clear) args.push('--clear')
  else {
    const value = String(body.value || '').replace(/[\r\n]/g, '')
    if (!value) return { ok: false, out: '值不能为空' }
    args.push('--no-verify', '--no-restart')
  }
  args.push('--env', name)
  if (!body.clear) args.push(String(body.value).replace(/[\r\n]/g, ''))
  const r = await runFile(BIN + '/dsh-set-key', args, 60000)
  if (body.restart && r.code === 0) {
    await runFile(BIN + '/sv', ['restart', 'dsh-web'], 30000)
    await sleep(4000)
  }
  return { ok: r.code === 0, out: r.out, state: await buildState() }
}

async function apiVerify() {
  // 用 bash -c + 位置参数传值，脚本串里不含任何用户输入。
  const script = 'set -a; [ -f "$1" ] && . "$1"; set +a; exec dsh headless "$2"'
  const r = await runFile(BIN + '/bash', ['-c', script, 'dsh-verify', KEYS, '只回答两个字：收到'], 200000)
  const bad = /MISSING_CREDENTIAL|AUTH:|TRANSPORT|Error|error/.test(r.out)
  return { ok: r.code === 0 && !bad, code: r.code, out: r.out }
}

/** 从 /models 的响应里取模型 id，兼容 data 数组 / models 数组 / models 字典三种形状。 */
function parseModelIds(bodyText) {
  let j
  try { j = JSON.parse(bodyText) } catch { return [] }
  const out = []
  const seen = new Set()
  const push = (v) => {
    const id = String(v == null ? '' : v).trim()
    if (id && !seen.has(id)) { seen.add(id); out.push(id) }
  }
  const arr = Array.isArray(j && j.data) ? j.data
    : Array.isArray(j && j.models) ? j.models
      : Array.isArray(j) ? j : null
  if (arr) {
    for (const m of arr) {
      if (m == null) continue
      if (typeof m === 'string') push(m)
      else push(m.id != null ? m.id : m.name != null ? m.name : m.model)
    }
    return out
  }
  if (j && j.models && typeof j.models === 'object') for (const k of Object.keys(j.models)) push(k)
  return out
}

/**
 * 去端点上拉模型列表。
 *
 * 两种协议的列表 URL 与鉴权方式都不同，不能一套头打天下：
 *   openai-completions → GET {base}/models          + Authorization: Bearer
 *   anthropic-messages → GET {base}/v1/models?limit=1000 + x-api-key + anthropic-version
 *     （列 URL 接受带或不带末尾 /v1 的根，这里统一归一化）
 */
async function apiModels(body) {
  const api = clean(body.api) || 'openai-completions'
  const base = clean(body.baseUrl).replace(/\/+$/, '')
  if (!/^https?:\/\//.test(base)) return { ok: false, out: 'baseURL 必须以 http(s):// 开头' }
  const key = String(body.key || '').replace(/[\r\n]/g, '')
    || (readCredentials().find((c) => c.name === clean(body.keyVar, 64)) || {}).value || ''
  if (!key) return { ok: false, out: '没有可用的 key：在这个账号里填一个，或先把它存进凭据' }

  let url
  let headers
  // 固定带一个 UA：部分 CDN / WAF 对「连 User-Agent 都没有」的请求直接回 429。
  const UA = { 'user-agent': 'dsh-ctl-gateway/1.0' }
  if (api === 'anthropic-messages') {
    url = (/\/v1$/.test(base) ? base : base + '/v1') + '/models?limit=1000'
    headers = Object.assign({ 'x-api-key': key, 'anthropic-version': '2023-06-01', accept: 'application/json' }, UA)
  } else {
    url = base + '/models'
    headers = Object.assign({ authorization: 'Bearer ' + key, accept: 'application/json' }, UA)
  }

  return new Promise((resolve) => {
    let target
    try { target = new URL(url) } catch { return resolve({ ok: false, code: 0, ms: 0, out: '端点无法解析：' + url }) }
    // 第三方端点基本都是 https，http.request 会直接报 ERR_INVALID_PROTOCOL。
    const mod = target.protocol === 'https:' ? https : http
    const t0 = Date.now()
    const req = mod.request(
      { host: target.hostname, port: target.port || (target.protocol === 'https:' ? 443 : 80),
        path: target.pathname + target.search, method: 'GET', timeout: 25000, headers },
      (res) => {
        let b = ''
        res.on('data', (d) => { b += d })
        res.on('end', () => {
          const ids = parseModelIds(b)
          const ms = Date.now() - t0
          const ok = res.statusCode >= 200 && res.statusCode < 300
          resolve(ok && ids.length
            ? { ok: true, code: res.statusCode, ms, models: ids, out: 'GET ' + url + ' → ' + res.statusCode + '，' + ids.length + ' 个模型（' + ms + 'ms）' }
            : { ok: false, code: res.statusCode, ms, out: 'GET ' + url + ' → ' + res.statusCode +
                (ok ? '（没解析出模型）\n' + b.slice(0, 800) : '（' + b.slice(0, 300) + '）') })
        })
      },
    )
    req.on('error', (e) => resolve({ ok: false, code: 0, ms: Date.now() - t0, out: 'GET ' + url + ' 失败：' + e.message }))
    req.on('timeout', () => { req.destroy(); resolve({ ok: false, code: 0, ms: Date.now() - t0, out: 'GET ' + url + ' 超时' }) })
    req.end()
  })
}

/**
 * 「健康」探测 —— 就是拿这把 token 去打一次它的模型列表端点。
 *
 * 只有「端点可达 + 返回 2xx」这一个信号，**不代表这把 key 真的能推理**：
 * 有些聚合站的 /models 根本不校验鉴权（dahl 就是），拿错 key 也回 200。
 * 所以面板上的「健康」只用来排除「端点写错 / 断网 / DNS 挂了」这类问题，
 * 真的要验 key，还得靠「端到端自检」真跑一次推理。
 */
async function apiHealth(body) {
  const r = await apiModels(body)
  return { ok: !!r.ok, code: r.code || 0, ms: r.ms || 0, out: r.out }
}

/**
 * 保存整份「接口 + token」清单。
 *
 * 顺序是刻意的：先落凭据 → 再改配置 → 最后才重启。反过来会出现「配置引用了
 * 还不存在的凭据」，服务起来直接 MISSING_CREDENTIAL；而且 dsh-set-provider
 * 只把 **已有凭据** 的 token 写成路由，凭据晚一步那把 token 就白配了。
 * 真正的写盘与校验交给设备上已回归过的 dsh-set-provider（它自带备份 + 组合
 * 校验 + 失败回滚），网关不碰 YAML。
 */
async function apiSave(body) {
  const rawSites = Array.isArray(body.sites) ? body.sites : []
  if (!rawSites.length) return { ok: false, out: '至少要保留一个接口' }
  const act = body.active && typeof body.active === 'object' ? body.active : {}
  const activeSite = clean(act.site, 64)
  const activeToken = clean(act.token, 64)
  const keys = body.keys && typeof body.keys === 'object' ? body.keys : {}
  const steps = []

  for (const name of Object.keys(keys)) {
    const value = String(keys[name] || '').replace(/[\r\n]/g, '')
    if (!value) continue
    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)) {
      return { ok: false, steps, out: '凭据变量名不合法：' + name }
    }
    const r = await runFile(BIN + '/dsh-set-key', ['--no-verify', '--no-restart', '--env', name, value], 60000)
    steps.push({ cmd: 'dsh-set-key --env ' + name + ' ****', code: r.code, out: r.out })
    if (r.code !== 0) return { ok: false, steps, out: r.out }
  }

  const sites = rawSites.map((s) => ({
    id: clean(s.id, 64),
    name: clean(s.name, 128),
    api: clean(s.api, 40),
    baseURL: clean(s.baseURL, 512),
    preset: clean(s.preset, 64),
    tokens: (Array.isArray(s.tokens) ? s.tokens : []).map((t) => ({
      id: clean(t.id, 64),
      note: clean(t.note, 128),
      label: clean(t.label, 64),
      keyVar: clean(t.keyVar, 64),
      defaultModel: clean(t.defaultModel, 256),
      enabled: t.enabled === false ? false : true,
      models: (Array.isArray(t.models) ? t.models : []).map((m) => clean(m, 256)).filter(Boolean),
    })),
  }))

  // 缺模型的密钥写不进 dsh（dsh-set-provider 按规矩拒），但整个清单不该被
  // 它拖死：完整的照写，缺模型的按「草稿」留在清单里（刷新后还在，配齐了再写）。
  // 启用归一只落在能写进 dsh 的完整密钥上，免得 active 指着一把不存在的路由。
  const drafts = []
  const dshSites = []
  for (const s of sites) {
    const tokens = []
    for (const t of s.tokens) {
      if (t.models.length && !t.defaultModel) t.defaultModel = t.models[0]
      if (!t.models.length || !t.defaultModel) {
        drafts.push(s.id + '-' + t.id + '（缺模型）')
        continue
      }
      tokens.push(t)
    }
    if (tokens.length) dshSites.push(Object.assign({}, s, { tokens }))
  }
  const draftNote = drafts.length
    ? '其中 ' + drafts.length + ' 把密钥缺模型，按草稿留在清单里、没写进 dsh：' + drafts.join('、') + '\n'
    : ''

  const actKeep = normalizeActive(dshSites, activeSite, activeToken)

  // 一把完整的密钥都没有：清单照存（草稿也是用户的心血），dsh 配置不动。
  if (!dshSites.length) {
    try {
      fs.writeFileSync(SITES_JSON, JSON.stringify({ active: { site: activeSite, token: activeToken }, sites }, null, 2) + '\n', 'utf8')
    } catch (e) {
      return { ok: false, steps, out: '写清单失败：' + String(e.message) }
    }
    return { ok: false, steps, out: '清单已存，但还没有一把完整的密钥（都缺模型）—— dsh 的配置没动，先不用重启。\n' + draftNote, state: await buildState() }
  }

  const file = TMPDIR + '/dsh-sites-' + process.pid + '-' + Date.now() + '.json'
  try {
    fs.writeFileSync(file, JSON.stringify({ active: actKeep, sites: dshSites }, null, 2), 'utf8')
    const r = await runFile(BIN + '/dsh-set-provider', ['--sites-file', file, '--no-restart'], 180000)
    steps.push({ cmd: 'dsh-set-provider --sites-file <清单> --no-restart', code: r.code, out: r.out })
    if (r.code !== 0) return { ok: false, steps, out: r.out }
  } finally {
    try { fs.unlinkSync(file) } catch {}
  }

  // 存档：只存 dsh 配置放不下的部分（备注、顺序、还没配凭据的 token）
  try {
    fs.writeFileSync(SITES_JSON, JSON.stringify({
      active: actKeep,
      sites,
    }, null, 2) + '\n', 'utf8')
  } catch (e) {
    steps.push({ cmd: '写 ' + SITES_JSON, code: 1, out: String(e.message) })
  }

  if (body.restart !== false) {
    const rr = await runFile(BIN + '/sv', ['restart', 'dsh-web'], 30000)
    await sleep(4000)
    const sr = await runFile(BIN + '/sv', ['status', 'dsh-web'], 10000)
    steps.push({ cmd: 'sv restart dsh-web', code: rr.code, out: sr.out })
  }
  if (body.verify) {
    const v = await apiVerify()
    steps.push({ cmd: 'dsh headless "只回答两个字：收到"', code: v.code, out: v.out })
    if (!v.ok) return { ok: false, steps, out: v.out, state: await buildState() }
  }
  return { ok: true, steps, state: await buildState(), out: draftNote || undefined }
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms))

/**
 * 「同一时间只有一把启用」的唯一判据 —— 写盘前归一化。
 *
 * 启用 = 当前生效 = 写进 dsh 的那条路由，三件事是一件事。面板已经用单开关守住了，
 * 这里再兜一道：清单被手改过、或换了版本读到老数据时，也保证落盘的清单里只有一把
 * `enabled: true`。不这么做的话，dsh-set-provider 会把**每一把** enabled 的 token
 * 都写成路由，多把启用等于多开线路，跟面板上那句「只有一把生效」就对不上了。
 *
 * 选定顺序：(`wantSite`,`wantToken`) 精确命中 → 同接口任一 token → 清单第一把。
 * @returns {{site: string, token: string}} 归一化后的 active
 */
function normalizeActive(sites, wantSite, wantToken) {
  const all = []
  for (const s of sites) for (const t of (s.tokens || [])) all.push({ s, t })
  if (!all.length) return { site: '', token: '' }
  const pick =
    all.find((x) => x.s.id === wantSite && x.t.id === wantToken) ||
    all.find((x) => x.s.id === wantSite) ||
    all[0]
  for (const x of all) x.t.enabled = x === pick
  return { site: pick.s.id, token: pick.t.id }
}

/**
 * 只落「清单」（sites.json），**不碰** dsh 的配置。
 *
 * 加接口 / 加 Token 这类结构改动走这里。那些改动生来就是不完整的（还没凭据、
 * 甚至还没模型），交给 dsh-set-provider 会被它按规矩拒掉 —— 而它拒的同时也
 * 不会写清单，结果就是「点了＋，刷新一下那行就没了」。清单是面板的记忆，
 * 配置是 dsh 的事实，本来就是两件事，分开写。
 *
 * 这里只做形状校验（接口 id / 变量名 / 至少一个接口），不校验完整性。
 */
async function apiManifest(body) {
  const rawSites = Array.isArray(body.sites) ? body.sites : []
  if (!rawSites.length) return { ok: false, out: '至少要保留一个接口' }
  const act = body.active && typeof body.active === 'object' ? body.active : {}

  const sites = []
  for (const s of rawSites) {
    const id = clean(s.id, 64)
    if (!/^[a-z][a-z0-9-]*$/.test(id)) {
      return { ok: false, out: '接口 id 不合法（要小写字母开头，只含小写字母、数字、连字符）：' + (id || '(空)') }
    }
    const tokens = []
    for (const t of (Array.isArray(s.tokens) ? s.tokens : [])) {
      const tid = clean(t.id, 64)
      const keyVar = clean(t.keyVar, 64)
      if (keyVar && !/^[A-Za-z_][A-Za-z0-9_]*$/.test(keyVar)) {
        return { ok: false, out: '凭据变量名不合法：' + keyVar }
      }
      tokens.push({
        id: tid,
        note: clean(t.note, 128),
        label: clean(t.label, 64),
        keyVar,
        defaultModel: clean(t.defaultModel, 256),
        enabled: t.enabled === false ? false : true,
        models: (Array.isArray(t.models) ? t.models : []).map((m) => clean(m, 256)).filter(Boolean),
      })
    }
    sites.push({
      id,
      name: clean(s.name, 128) || id,
      api: clean(s.api, 40) || 'openai-completions',
      baseURL: clean(s.baseURL, 512),
      preset: clean(s.preset, 64),
      tokens,
    })
  }

  // 归一化：只有 active 指的那把会被标成启用，其余一律待命
  // （不变量：同一时间只有一把启用；也是 dsh-set-provider 要求的形态）。
  const keep = normalizeActive(sites, clean(act.site, 64), clean(act.token, 64))

  try {
    fs.writeFileSync(SITES_JSON, JSON.stringify({ active: keep, sites }, null, 2) + '\n', 'utf8')
  } catch (e) {
    return { ok: false, out: '写 ' + SITES_JSON + ' 失败：' + String(e.message) }
  }
  return {
    ok: true,
    out: '已写清单 ' + SITES_JSON + '（' + sites.length + ' 个接口 / ' +
         sites.reduce((n, s) => n + s.tokens.length, 0) + ' 把密钥）。\n' +
         'dsh 的配置这次没动 —— 要让它生效得再点「保存并重启」。',
    state: await buildState(),
  }
}

/* ------------------------------------------------------------------ HTTP */

function readBody(req) {
  return new Promise((resolve) => {
    let b = ''
    req.on('data', (d) => { b += d; if (b.length > 2e6) req.destroy() })
    req.on('end', () => { try { resolve(b ? JSON.parse(b) : {}) } catch { resolve({}) } })
  })
}

function json(res, code, obj) {
  const s = JSON.stringify(obj)
  res.writeHead(code, { 'content-type': 'application/json; charset=utf-8', 'content-length': Buffer.byteLength(s), 'cache-control': 'no-store' })
  res.end(s)
}

function html(res, code, body) {
  res.writeHead(code, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' })
  res.end(body)
}

const CTL_API = {
  // 未登录（路由器模型）也能取的是 state；buildState 按登录态决定给不给明文 key
  state: async (b, ctx) => buildState(!!(ctx && ctx.authed)),
  save: apiSave,
  manifest: apiManifest,
  apply: apiApply,
  key: apiKey,
  verify: apiVerify,
  models: apiModels,
  health: apiHealth,
 dshcheck: apiDshCheck,
 dshupgrade: apiDshUpgrade,
 install: apiInstall,
 repair: apiRepair,
 uninstall: apiUninstall,
 jobstatus: apiJobStatus,
 restart: async (b, ctx) => {
    const authed = !!(ctx && ctx.authed)
    const r = await runFile(BIN + '/sv', ['restart', 'dsh-web'], 30000)
    await sleep(4000)
    const s = await runFile(BIN + '/sv', ['status', 'dsh-web'], 10000)
    return { ok: r.code === 0, out: s.out, state: await buildState(authed) }
  },
 log: async (b) => ({ ok: true, out: serviceLog(clean(b.name) || 'dsh-web', Number(b.lines) || 60) }),
}

/* 路由器模型：不登录也能用的接口子集。
 * 装完网关打开 http://<lan-ip>:8030/ 就是控制台，装 / 修 / 卸 / 看状态全都直接点
 * （像路由器管理页一样信任局域网）。但 save / apply / manifest / key 这些能改
 * 配置、读写明文密钥的一律排除：改 dsh 后端必须登录 dsh（/app）。 */
const OPEN_API = ['state', 'install', 'repair', 'uninstall', 'jobstatus', 'dshcheck', 'dshupgrade', 'log', 'restart']

async function handleCtl(req, res, url) {
  const hostHeader = req.headers.host || ''
  const cookie = req.headers.cookie || ''
  const code = await probeAuth(hostHeader, cookie)
  const authed = code === 404
  // 登录与否只往 ctx 里带：面板、生命周期接口对局域网全开（路由器模型）
  const ctx = { authed }

  if (url.pathname === '/ctl' || url.pathname === '/ctl/') {
    // 路由器模型：控制台直接伺候，不弹任何令牌表单
    return html(res, 200, PANEL_HTML)
  }
  if (!url.pathname.startsWith('/ctl/api/')) return json(res, 404, { ok: false, out: 'not found' })

  const name = url.pathname.slice('/ctl/api/'.length)
  const fn = CTL_API[name]
  if (!fn) return json(res, 404, { ok: false, out: 'unknown api ' + name })

  // body 只读一次：请求流不能重放
  let body = {}
  if (req.method === 'POST') {
    try { body = await readBody(req) } catch { body = {} }
  }

  if (authed) {
    // 已登录 dsh：完整权限（含改配置 / 读明文密钥）
    try {
      return json(res, 200, await fn(body, ctx))
    } catch (e) {
      return json(res, 500, { ok: false, out: String((e && e.stack) || e) })
    }
  }

  // 未登录：白名单内照常（state 的明文 key 由 buildState 按登录态掩掉）
  if (OPEN_API.indexOf(name) < 0) {
    return json(res, 401, { ok: false,
      out: '改配置 / 凭据的接口需要先登录 dsh（打开 /app）。装 / 修 / 卸 / 看状态不登录也能用。' })
  }
 try {
    return json(res, 200, await fn(body, ctx))
  } catch (e) {
    return json(res, 500, { ok: false, out: String((e && e.stack) || e) })
  }
}

/* ------------------------------------------------------------------ 代理 */

function proxy(req, res, rewrite) {
  const path = rewrite && rewrite.path ? rewrite.path : req.url
  const p = http.request(
    { host: UP_HOST, port: UP_PORT, path, method: req.method, headers: req.headers },
    (pres) => {
      // 令牌登录失败（401/403）与其把 dsh 的裸 401 甩给浏览器，不如让调用方给个说人话的页
      if (rewrite && rewrite.on401 && (pres.statusCode === 401 || pres.statusCode === 403)) {
        pres.resume()
        return rewrite.on401()
      }
      const headers = Object.assign({}, pres.headers)
      if (rewrite && rewrite.location && headers.location) headers.location = rewrite.location
      res.writeHead(pres.statusCode || 502, headers)
      pres.pipe(res)
    },
  )
  p.on('error', (e) => {
    if (res.headersSent) return res.destroy()
    html(res, 502, downPage(e.message))
  })
  req.pipe(p)
}

/**
 * 把 dsh 主界面挂到 /app。
 *
 * dsh 自己只会把前端吐在 `/`（`/dsh` 之类一律 404，没有 SPA fallback），
 * 而它的 index.html 用的是相对引用 `./assets/…`。所以这里由网关自己去上游
 * 取回 `/` 的 index.html，再以 200 吐给浏览器 —— 浏览器按 `/app` 的目录基
 * （也就是 `/`）解析相对引用，正好落到 `/assets/…`、`/langs/…`、`/fonts/…`，
 * 全部命中下面的兜底转发。等于给 dsh 前端做了个免改动的子路径挂载。
 *
 * 反过来不能挂到 `/app/`：那样目录基变成 `/app/`，相对引用会变成
 * `/app/assets/…`，上游 404。所以 /app/ 一律 302 回 /app。
 */
function serveSpa(req, res) {
  const headers = { host: req.headers.host || '', 'accept-encoding': 'identity' }
  if (req.headers.cookie) headers.cookie = req.headers.cookie
  const p = http.request(
    { host: UP_HOST, port: UP_PORT, path: '/', method: 'GET', headers, timeout: 15000 },
    (pres) => {
      let b = ''
      pres.setEncoding('utf8')
      pres.on('data', (d) => { b += d })
      pres.on('end', () => {
        if (res.headersSent) return
        if (pres.statusCode === 200) {
          res.writeHead(200, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' })
          return res.end(b)
        }
        // 401/403 = dsh 在线但这个浏览器没登录 → 登录页；其它非 200 当上游挂了处理
        if (pres.statusCode === 401 || pres.statusCode === 403) {
          return html(res, 200, loginPage(req.headers.host || ''))
        }
        return html(res, 200, downPage('取 dsh 首页返回 ' + pres.statusCode))
      })
    },
  )
  p.on('error', (e) => { if (!res.headersSent) html(res, 502, downPage(e.message)) })
  p.on('timeout', () => { p.destroy(); if (!res.headersSent) html(res, 504, downPage('取 dsh 首页超时')) })
  p.end()
}

