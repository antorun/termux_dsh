function loginPage(host, note) {
  return shell('dsh 控制台 · 需登录', `
<h1>需要先登录 dsh</h1>
<div class="sub">控制台复用 dsh 自己的登录 cookie，不额外设第二套口令。</div>
<div class="card">
  <p>这个浏览器还没有 <kbd>${host}</kbd> 这个地址上的有效登录。</p>
  <p class="muted">dsh 的 cookie 是<b>按 authority 绑定</b>的，所以 3080 登过不等于 8030 登过，需要在 8030 上单独走一次。</p>
  ${note ? '<p class="muted" style="color:var(--warn)">' + note + '</p>' : ''}
  <p class="row">
    <a href="/app"><button class="primary">打开 /app（自动登录）→</button></a>
    <a href="/"><button>去控制台首页</button></a>
  </p>
</div>`)
}

function downPage(msg) {
  return shell('dsh 网关 · 上游不可达', `
<h1>连不上 dsh web</h1>
<div class="sub">网关在跑，但 127.0.0.1:${UP_PORT} 没应答。</div>
<div class="card"><pre>${msg}</pre>
<p class="muted">到手机上执行： <kbd>sv status dsh-web</kbd> → <kbd>sv restart dsh-web</kbd></p></div>`)
}


/* ------------------------------------------------------------------ 启动 */

let server = null
let boundHost = null

async function onRequest(req, res) {
  let url
  try { url = new URL(req.url, 'http://' + (req.headers.host || 'localhost')) }
  catch { url = { pathname: req.url.split('?')[0], searchParams: new URLSearchParams() } }

  const p = url.pathname

  // 控制台（含它的 API）
  if (p === '/ctl' || p.startsWith('/ctl/')) return handleCtl(req, res, url)

  // dsh 主界面
  if (p === '/app') {
    const token = url.searchParams.get('token')
    if (token) {
      // 令牌必须由 dsh 自己下发（它会按 authority 种 cookie），
      // 所以把路径改写成 '/' 转发，再把 303 的落点改回 /app。
      // 令牌失效时透传 dsh 的 401 没人看得懂 —— 落到登录页说明白。
      return proxy(req, res, {
        path: '/' + url.search, location: '/app',
        on401: () => html(res, 200, loginPage(req.headers.host || '', '令牌没通过：可能已过期。重新打开 /app 会自动接当前令牌，或去控制台首页拿新链接。')),
      })
    }
    // 路由器模型：打开 /app 直接进。先探这个浏览器对当前 authority 有没有
    // 有效登录（带上它的 cookie 探）—— 有就取首页；没有（没登过 / cookie 过期 /
    // 在别的 authority 登的，浏览器里有陈旧 cookie 也算这类）就自取 dsh 的登录
    // 令牌补上：readToken 跑 dsh-web-url，302 到 /app?token=… 让 dsh 按
    // 当前 authority 种好 cookie 再落回 /app。
    // 不能只看「有没有 cookie」：陈旧 cookie 的浏览器会卡在登录页死循环。
    const code = await probeAuth(req.headers.host || '', req.headers.cookie || '')
    if (code !== 404) {
      const t = await readToken()
      const m = t && /token=([A-Za-z0-9_-]+)/.exec(t)
      if (m) {
        res.writeHead(302, { location: '/app?token=' + m[1], 'cache-control': 'no-store' })
        return res.end()
      }
    }
    return serveSpa(req, res)
  }
  if (p.startsWith('/app/') || p === '/app.html') {
    res.writeHead(302, { location: '/app', 'cache-control': 'no-store' })
    return res.end()
  }

  // 网关自己的首页 = 管理控制台（路由器模型：直接给面板，不问令牌也不问登录）
  if (p === '/' || p === '/index.html') {
    // 老链接 / 书签里的 /?token=… 仍然要能用 —— 挪到 /app 走登录
    if (url.searchParams.get('token')) {
      res.writeHead(302, { location: '/app' + url.search, 'cache-control': 'no-store' })
      return res.end()
    }
    return html(res, 200, PANEL_HTML)
  }

  // 其余（/assets /langs /fonts /api favicon manifest…）一律透明转发
  return proxy(req, res)
}

function onUpgrade(req, socket, head) {
  const up = net.connect(UP_PORT, UP_HOST, () => {
    const lines = [req.method + ' ' + req.url + ' HTTP/1.1']
    for (let i = 0; i < req.rawHeaders.length; i += 2) lines.push(req.rawHeaders[i] + ': ' + req.rawHeaders[i + 1])
    up.write(lines.join('\r\n') + '\r\n\r\n')
    if (head && head.length) up.write(head)
    socket.pipe(up)
    up.pipe(socket)
  })
  const tear = () => { socket.destroy(); up.destroy() }
  socket.on('error', tear)
  up.on('error', tear)
  socket.on('close', tear)
  up.on('close', tear)
}

function bind() {
  const host = LISTEN_HOST === 'auto' ? lanIp() : LISTEN_HOST
  if (!host) {
    console.error('dsh-ctl-gateway: 还没有局域网 IP，' + RETRY_MS / 1000 + ' 秒后重试')
    setTimeout(bind, RETRY_MS)
    return
  }
  if (server && boundHost === host && server.listening) return
  if (server) {
    const old = server
    server = null
    boundHost = null
    try { old.close() } catch {}
  }
  const s = http.createServer(onRequest)
  s.on('upgrade', onUpgrade)
  s.on('error', (err) => {
    console.error('dsh-ctl-gateway: 监听 ' + host + ':' + LISTEN_PORT + ' 失败：' + err.message + '；' + RETRY_MS / 1000 + ' 秒后重试')
    setTimeout(bind, RETRY_MS)
  })
  s.listen(LISTEN_PORT, host, () => {
    boundHost = host
    console.log('dsh-ctl-gateway: http://' + host + ':' + LISTEN_PORT + '/  (控制台 /ctl) -> ' + UP_HOST + ':' + UP_PORT)
    // 启动自检：围栏必须放行本 authority（期望 401 = 围栏过了、只是没登录）。
    probeAuth(host + ':' + LISTEN_PORT, '').then((code) => {
      if (code === 401) {
        console.log('  ✓ /api 围栏放行 ' + host + ':' + LISTEN_PORT + '（401 = 等登录）')
      } else if (code === 403) {
        console.log('  ✗ /api 围栏拒绝了 ' + host + ':' + LISTEN_PORT + ' —— dsh-web 的 run 脚本里需要 --trusted-host ' + host)
      } else if (code === 404) {
        console.log('  ! 探针路径被当成已存在路由处理了（404 当成"已登录"会误判）')
      } else {
        console.log('  ! 探针没结果（code=' + code + '）：dsh-web 可能还没起来')
      }
    })
  })
  server = s
}

/* auto 模式另起一个 loopback 监听：手机本机 127.0.0.1:8030 直连，不用绕局域网。
 * 两条路并存：局域网那台等 IP、重绑随 WiFi 变；loopback 永远在，WiFi 没连
 * 也能用。显式 LISTEN_HOST 模式（测试用）只有一个监听，不重复绑。 */
let loopServer = null
function bindLoopback() {
  if (LISTEN_HOST !== 'auto') return
  if (loopServer && loopServer.listening) return
  if (loopServer) { try { loopServer.close() } catch {} }
  const s = http.createServer(onRequest)
  s.on('upgrade', onUpgrade)
  s.on('error', (err) => {
    console.error('dsh-ctl-gateway: 监听 127.0.0.1:' + LISTEN_PORT + ' 失败：' + err.message + '；' + RETRY_MS / 1000 + ' 秒后重试')
    setTimeout(bindLoopback, RETRY_MS)
  })
  s.listen(LISTEN_PORT, '127.0.0.1', () => {
    console.log('dsh-ctl-gateway: http://127.0.0.1:' + LISTEN_PORT + '/  (本机直连) -> ' + UP_HOST + ':' + UP_PORT)
    probeAuth('127.0.0.1:' + LISTEN_PORT, '').then((code) => {
      if (code === 401) {
        console.log('  ✓ /api 围栏放行 127.0.0.1:' + LISTEN_PORT + '（401 = 等登录）')
      } else if (code === 403) {
        console.log('  ✗ /api 围栏拒绝了 127.0.0.1:' + LISTEN_PORT + ' —— loopback 本该放行')
      } else if (code === 404) {
        console.log('  ! 探针路径被当成已存在路由处理了（404 当成"已登录"会误判）')
      } else {
        console.log('  ! 探针没结果（code=' + code + '）：dsh-web 可能还没起来')
      }
    })
  })
  loopServer = s
}

// 启动第一件事：把上次留在盘上的任务对上账 —— 已结束的留作 jobstatus 回看现场，
// 运行中的 detached 卸载接着盯（并发护栏因此跨重启有效）
reconcileJob()

bind()
bindLoopback()

setInterval(() => {
  if (LISTEN_HOST !== 'auto') return
  const want = lanIp()
  if (want && want !== boundHost) {
    console.log('dsh-ctl-gateway: 局域网 IP 变了 ' + boundHost + ' -> ' + want + '，重建监听')
    console.log('  ！dsh-web 的 --trusted-host 仍是旧 IP，请执行: sv restart dsh-web')
    bind()
  }
}, RECHECK_MS)
