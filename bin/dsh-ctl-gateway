#!/data/data/com.termux/files/usr/bin/node
/*
 * dsh-ctl-gateway -- 局域网上的 dsh「控制台 + 入口」网关，默认监听 :8030。
 *
 * 它做三件事：
 *   1. 透明反向代理到只监听 127.0.0.1 的 dsh web（HTTP + WebSocket 都透传）。
 *      header 一个都不改 —— dsh 侧靠 `--trusted-host <lan-ip>`（端口无关的 IP
 *      字面量）放行 /api 围栏，改 Host 反而会在 keep-alive 的后续请求上坏掉。
 *   2. 提供 /ctl 控制台：看服务状态、管理「接口 + token」（端点 / 协议 / 每把
 *      token 的备注、启用开关与凭据 / 模型）、重启、跑端到端自检、
 *      从端点拉模型列表、探测每把 token 的端点健康。
 *      一个接口挂 N 把 token，dsh 里就是 N 条 "<接口>-<token>" 路由。
 *      token 的 `enabled:false` = 停用，清单里留着但不写路由。
 *   3. 未登录时给一个说人话的落地页，而不是把 dsh 的 401 甩给用户。
 *
 * 路由（8030 是"网关自己的入口"，dsh 主界面被挪到 /app）：
 *   /              控制台面板（路由器模型：不问令牌不问登录）
 *   /ctl[/…]       控制台别名 + 控制台 API
 *   /app           dsh 主界面：没 cookie 时自动补上 dsh 的登录令牌再进来
 *   /app/…         302 回 /app（避免相对资源按 /app/ 目录基解析而 404）
 *   其余           一律透明转发（/assets /langs /fonts /api favicon…）
 *
 * 写入一律通过设备上已回归过的 dsh-set-provider / dsh-set-key 完成
 * （spawn argv 数组，不过 shell，杜绝命令注入），网关自己只读。
 *
 * 鉴权：/ctl 要求 dsh 自己的登录 cookie。判定方式是把请求原样探到
 * dsh 的 /api/__ctl_probe —— 围栏+鉴权都过时该路径会回 404（路由不存在），
 * 401=没登录、403=围栏拒绝。这样控制台的安全级别与 dsh UI 本体一致，
 * 不额外引入第二套口令。
 *
 * 用法: dsh-ctl-gateway <listenHost|auto> <listenPort> <upstreamHost> <upstreamPort>
 *       listenHost=auto 时同时绑两个：LAN IP（随 WiFi 变重绑）+ 127.0.0.1
 */
'use strict'

const http = require('http')
const https = require('https')
const net = require('net')
const fs = require('fs')
const os = require('os')
const { execSync, execFile, spawn } = require('child_process')

const argv = process.argv.slice(2)
if (argv.length < 4) {
  console.error('用法: dsh-ctl-gateway <listenHost|auto> <listenPort> <upstreamHost> <upstreamPort>')
  process.exit(2)
}
const LISTEN_HOST = argv[0]
const LISTEN_PORT = Number(argv[1])
const UP_HOST = argv[2]
const UP_PORT = Number(argv[3])

const PREFIX = process.env.PREFIX || '/data/data/com.termux/files/usr'
const HOME = process.env.HOME || PREFIX.replace(/\/usr$/, '') + '/home'
const DSH_HOME = process.env.DSH_HOME || HOME + '/.dsh'
const SVD = PREFIX + '/var/service/dsh-web'
const KEYS = SVD + '/environment'
const BIN = PREFIX + '/bin'
const SVDIR = PREFIX + '/var/service'
const TMPDIR = process.env.TMPDIR || PREFIX + '/tmp'
const SITES_JSON = DSH_HOME + '/sites.json'
const ACCOUNTS_JSON = DSH_HOME + '/accounts.json'   // 旧版单账号存档，只用来迁移

/* dsh 自己（npm 全局包）的路径 —— 版本更新功能用得到。 */
const SHARE = PREFIX + '/share/dsh-ctl'
const PATCHER = SHARE + '/patches.py'          // JS 补丁器（随仓库下发，见 §6.8）
const FLOCK_BUILD = SHARE + '/build-flock.sh'  // android-arm64 的 flock 原生插件编译脚本
const DSH_PKG = '@deepseek-ai/dsh'
const DSH_SCOPE = PREFIX + '/lib/node_modules/@deepseek-ai'
const DSH_DIR = DSH_SCOPE + '/dsh'
const DSH_PKG_JSON = DSH_DIR + '/package.json'
const FLOCK_NATIVE = DSH_DIR + '/node_modules/@deepseek-ai/node-addon-system-android-arm64/bin/system.node'
const NPM_BIN = BIN + '/npm'
const NPM_UPGRADE_TIMEOUT = 900000   // 15 分钟：Termux 上装 300MB 级的包，别急着判死

/* 网关自己下发的设备端脚本（由 install-gateway.sh 落到 share/dsh-ctl/）。
 * 安装 / 升级流程要它们在场，缺了就是网关没装全，控制台相应入口禁用。
 * uninstall.sh 随网关下发，控制台「卸载」按钮调它（apiUninstall），
 * 手工执行也走同一条路、同样的参数。 */
const INSTALL_WEB_SERVICE_SH = SHARE + '/install-web-service.sh'
const UNINSTALL_SH = SHARE + '/uninstall.sh'

/* job 落盘（见下方「任务运行器」）：任务现场写进 TMPDIR 的一个 JSON 文件，
 * 网关被重启 / 被杀后，新进程启动时把上次的任务对上账（恢复回看现场、
 * 继续盯 detached 的卸载子进程、或标记中断）。TMPDIR 在 Termux 上是
 * $PREFIX/tmp，重启不丢；卸载删的是 share/dsh-ctl，不删这里。
 * 卸载日志 / 退出码落码同理 —— detached 子进程写，网关读。 */
const JOB_FILE = TMPDIR + '/dsh-ctl-job.json'

const CHILD_ENV = Object.assign({}, process.env, {
  PREFIX,
  DSH_HOME,
  // sv 命令靠 SVDIR 找服务目录；网关进程是从 runit 起的，未必继承到它
  // （非交互 shell / SSH 环境经常没有），缺了的话 sv status 全报「未运行」。
  SVDIR,
  PATH: BIN + ':' + BIN + '/applets:' + (process.env.PATH || ''),
})

/* 装包时给原生模块用的编译标志。
 *
 * dsh 0.2.0+ 依赖 koffi，它的 cnoke.cjs 在 android-arm64 上拿不到预编译二进制，
 * 会回退到 CMake 源码编译。而 bionic 的 <sys/stat.h> 里 statx() 长这样：
 *   #if defined(__USE_GNU) && __BIONIC_AVAILABILITY_GUARD(30)
 *   int statx(int, const char*, int, unsigned, struct statx*) __INTRODUCED_IN(30);
 *   #endif
 * 两个条件缺一不可：__USE_GNU 要 -D_GNU_SOURCE，API 级别要 >= 30。
 * 少了任何一条，statx 就只剩「类型」而没有「函数」，于是
 *   statx(fd, pathname, flags, mask, &sxb)
 * 被解析成一次强制类型转换，报的就是那句莫名其妙的
 *   cannot initialize a member subobject of type '__u32' with an lvalue of type 'const char *'
 * —— 看着像参数类型写错了，其实是函数根本没声明。
 *
 * 设备实测（clang 21.1.8 / make / cmake 4.4.3 / ninja 1.13.2）：
 *   裸编译                                     ✗ statx 不可见
 *   -D_GNU_SOURCE                              ✗（API 级别不够）
 *   -D_GNU_SOURCE -D__ANDROID_API__=30         ✗（宏被内置定义覆盖）
 *   --target=aarch64-unknown-linux-android30 -D_GNU_SOURCE  ✓ 编/链/跑全通
 * CMake 从环境变量 CFLAGS / CXXFLAGS 里吃得下这组标志（已用最小工程验证）。
 */
const ANDROID30_FLAGS = '--target=aarch64-unknown-linux-android30 -D_GNU_SOURCE'
const NPM_BUILD_ENV = Object.assign({}, CHILD_ENV, {
  CFLAGS: ANDROID30_FLAGS,
  CXXFLAGS: ANDROID30_FLAGS,
  CPPFLAGS: '-D_GNU_SOURCE',
})

const RETRY_MS = 5000
const RECHECK_MS = 20000

const PANEL_HTML = (() => {
  try {
    return fs.readFileSync(PREFIX + '/share/dsh-ctl/panel.html', 'utf8')
  } catch (e) {
    return '<!doctype html><meta charset="utf-8"><body style="font:14px sans-serif;padding:24px">' +
      '控制台页面文件缺失：' + PREFIX + '/share/dsh-ctl/panel.html</body>'
  }
})()

/* ---------------------------------------------------------------- 基础工具 */

function runFile(file, args, timeoutMs, env) {
  return new Promise((resolve) => {
    const child = execFile(
      file,
      args,
      { env: env || CHILD_ENV, timeout: timeoutMs || 60000, maxBuffer: 8 * 1024 * 1024 },
      (err, stdout, stderr) => {
        resolve({
          code: err && typeof err.code === 'number' ? err.code : err ? 1 : 0,
          out: String(stdout || '') + String(stderr || ''),
        })
      },
    )
    child.on('error', (e) => resolve({ code: 127, out: '执行失败: ' + e.message }))
  })
}

/** 把用户值里的换行剔掉，避免往 YAML / 命令行里灌结构。 */
function clean(v, max) {
  return String(v == null ? '' : v).replace(/[\r\n]+/g, ' ').trim().slice(0, max || 512)
}

function mask(v) {
  if (!v) return ''
  return v.length > 12 ? v.slice(0, 6) + '…' + v.slice(-4) : '****'
}

/**
 * 凭据的「识别名」—— 列表里一眼认出一把 key 用。
 * 取前 4 + 后 4（`dahl.om8Y` / `sk-7.ca14`），足够区分又不足以复用。
 * 别指望它保密，它的作用只是让人不把两把 key 搞混。
 */
function hint(v) {
  if (!v) return ''
  const s = String(v)
  if (s.length >= 12) return s.slice(0, 4) + '.' + s.slice(-4)
  return s.length > 4 ? s : '****'
}

function lanIp() {
  try {
    const out = execSync('ifconfig 2>/dev/null', { encoding: 'utf8', timeout: 5000, env: CHILD_ENV })
    let iface = ''
    let fallback = ''
    for (const line of out.split('\n')) {
      const m = /^([A-Za-z0-9][A-Za-z0-9_.-]*):/.exec(line)
      if (m) { iface = m[1]; continue }
      const i = /^\s+inet\s+(?:addr:)?([0-9.]+)/.exec(line)
      if (!i) continue
      const ip = i[1]
      if (ip === '127.0.0.1') continue
      if (iface === 'wlan0') return ip
      if (iface !== 'vgate0' && fallback === '') fallback = ip
    }
    return fallback
  } catch { return '' }
}

/* ------------------------------------------------------------ 状态读取（只读） */

function readText(p) {
  try { return fs.readFileSync(p, 'utf8') } catch { return '' }
}

/** YAML 标量去引号：生成的清单带双引号，手写的多半不带。 */
function unquote(v) {
  const s = String(v == null ? '' : v).trim()
  if (s.length > 1 && s[0] === '"' && s[s.length - 1] === '"') {
    try { return JSON.parse(s) } catch { return s.slice(1, -1) }
  }
  if (s.length > 1 && s[0] === "'" && s[s.length - 1] === "'") return s.slice(1, -1)
  return s
}

/** 取出 dsh-set-provider 管理的那一段配置。 */
function providerBlock() {
  const s = readText(DSH_HOME + '/profiles/web/cordis.patch.yml')
  const m = /# >>> dsh-provider[^\n]*\n([\s\S]*?)# <<< dsh-provider/.exec(s)
  return m ? m[1] : ''
}

/** 从生效配置里反解出「路由」：路由 id = "<接口 id>-<token id>"。 */
function routesFromBlock(block) {
  const out = []
  if (!/^\s*- id: llm-pi-ai/m.test(block)) return out
  let cur = null
  let inModels = false
  for (const l of block.split('\n')) {
    let m
    if ((m = /^ {6}([a-z][a-z0-9-]*):\s*$/.exec(l))) {
      if (cur) out.push(cur)
      cur = { id: m[1], api: '', baseURL: '', keyVar: '', displayName: m[1], models: [] }
      inModels = false
      continue
    }
    if (!cur) continue
    if ((m = /^ {8}apiKeyEnv:\s*(.+)$/.exec(l))) { cur.keyVar = unquote(m[1]); continue }
    if ((m = /^ {8}displayName:\s*(.+)$/.exec(l))) { cur.displayName = unquote(m[1]); continue }
    if ((m = /^ {8}api:\s*(.+)$/.exec(l))) { cur.api = unquote(m[1]); continue }
    if ((m = /^ {8}baseURL:\s*(.+)$/.exec(l))) { cur.baseURL = unquote(m[1]); continue }
    if (/^ {8}models:\s*$/.test(l)) { inModels = true; continue }
    if (inModels && (m = /^ {10}- id:\s*(.+)$/.exec(l))) { cur.models.push(unquote(m[1])); continue }
    if (inModels && /^ {8}\S/.test(l)) inModels = false
  }
  if (cur) out.push(cur)
  return out
}

/** 路由 id → {site, token}。末尾的 -t<数字> 是 token，其余是接口。 */
function splitRoute(rid) {
  const m = /^(.+)-t(\d+)$/.exec(rid)
  return m ? { site: m[1], token: 't' + m[2] } : { site: rid, token: 't1' }
}

/** 旧版 accounts.json → 新版接口结构：一个账号 = 一个接口挂一把 token。 */
function sitesFromLegacyAccounts(j) {
  return {
    active: { site: String(j.active || '').trim(), token: 't1' },
    sites: (j.accounts || []).map((a) => ({
      id: String(a.id || '').trim(),
      name: String(a.displayName || a.id || '').trim(),
      api: String(a.api || '').trim(),
      baseURL: String(a.baseURL || '').trim(),
      tokens: [{
        id: 't1',
        note: '默认',
        keyVar: String(a.keyVar || '').trim(),
        defaultModel: String(a.defaultModel || '').trim(),
        models: (Array.isArray(a.models) ? a.models : []).map((m) => unquote(m)).filter(Boolean),
      }],
    })).filter((s) => s.id),
  }
}

/** 只有配置、没有任何存档时：把路由反解成接口（含老的 llm-deepseek 单账号形态）。 */
function sitesFromRoutes(routes, block) {
  if (!routes.length) {
    if (!/^\s*- id: llm-deepseek/m.test(block)) return null
    const url = /^\s*baseURL:\s*([^\s#]+)/m.exec(block)
    const models = []
    let inModels = false
    for (const l of block.split('\n')) {
      if (/^\s+models:\s*$/.test(l)) { inModels = true; continue }
      const m = /^\s+- id:\s*([^\s#]+)/.exec(l)
      if (inModels && m) models.push(unquote(m[1]))
    }
    return {
      active: { site: 'deepseek', token: 't1' },
      sites: [{
        id: 'deepseek', name: 'Anthropic 兼容端点', api: 'anthropic-messages',
        baseURL: url ? unquote(url[1]) : 'https://api.deepseek.com/anthropic',
        tokens: [{ id: 't1', note: '默认', keyVar: 'DEEPSEEK_API_KEY', defaultModel: '', models }],
      }],
    }
  }
  const sites = []
  const byId = new Map()
  for (const r of routes) {
    const { site, token } = splitRoute(r.id)
    let s = byId.get(site)
    if (!s) {
      // displayName 是 "<接口名> · <备注>"，反解时拆不开 —— 接口名留空让面板
      // 退回显示 id，备注则去掉接口名前缀，免得叠成 "A · A · 主号"。
      s = { id: site, name: '', api: r.api, baseURL: r.baseURL, tokens: [] }
      byId.set(site, s)
      sites.push(s)
    }
    let note = r.displayName || token
    const cut = note.lastIndexOf(' · ')
    if (cut > 0) note = note.slice(cut + 3)
    s.tokens.push({ id: token, note, keyVar: r.keyVar, defaultModel: '', models: r.models.slice() })
  }
  return { active: { site: '', token: '' }, sites }
}

/**
 * 读出「接口清单 + 当前激活」。一个接口 = 一个 baseURL + 协议；一个 token =
 * 这个接口上的一把钥匙（带备注），各自一组模型。dsh 里的路由 id 就是
 * "<接口 id>-<token id>"，所以同一接口的多把 token 在 dsh 自己的模型选择器里
 * 就能切换 —— 限流了换一把即可，不用动端点配置。
 *
 * 两个来源合并：
 *   · sites.json（控制台写的存档：备注、顺序、还没配凭据的 token）
 *   · cordis.patch.yml 的 dsh-provider 块（真正生效的那份，也是 active 的真源）
 *
 * 没有存档时依次退回：旧 accounts.json → 从生效配置反解。所以任何历史形态
 * 都能直接读出来，不需要手工迁移。
 */
function readSites() {
  const block = providerBlock()
  const routes = routesFromBlock(block)
  const creds = readCredentials()

  let activeRoute = ''
  let activeModel = ''
  const am = /- id: agent-default-model[\s\S]*?\n\s*provider:\s*([^\s#]+)[\s\S]*?\n\s*model:\s*([^\s#]+)/.exec(block)
  if (am) { activeRoute = unquote(am[1]); activeModel = unquote(am[2]) }

  let migrated = false
  let store = (() => {
    try {
      const j = JSON.parse(readText(SITES_JSON))
      return j && Array.isArray(j.sites) && j.sites.length ? j : null
    } catch { return null }
  })()
  if (!store) {
    const legacy = (() => {
      try {
        const j = JSON.parse(readText(ACCOUNTS_JSON))
        return j && Array.isArray(j.accounts) && j.accounts.length ? j : null
      } catch { return null }
    })()
    store = legacy ? sitesFromLegacyAccounts(legacy) : sitesFromRoutes(routes, block)
    if (store) migrated = true
  }
  if (!store) store = { active: { site: '', token: '' }, sites: [] }

  const sites = store.sites.map((s) => ({
    id: String(s.id || '').trim(),
    name: String(s.name || s.id || '').trim(),
    api: String(s.api || '').trim() || 'openai-completions',
    baseURL: String(s.baseURL || '').trim(),
    preset: String(s.preset || '').trim(),
    tokens: (Array.isArray(s.tokens) ? s.tokens : []).map((t) => ({
      id: String(t.id || '').trim(),
      note: String(t.note || '').trim(),
      label: String(t.label || '').trim(),
      keyVar: String(t.keyVar || '').trim(),
      defaultModel: String(t.defaultModel || '').trim(),
      // 停用开关：存档里没写就是启用（老清单直接读也不会集体消失）
      enabled: t.enabled === undefined ? true : !!t.enabled,
      models: (Array.isArray(t.models) ? t.models : []).map((m) => unquote(m)).filter(Boolean),
    })).filter((t) => t.id),
  })).filter((s) => s.id)

  // 每条路由的现状回填到 token 上（是否注册、凭据在不在），只报「有没有」不回传值
  const routeIndex = new Map(routes.map((r) => [r.id, r]))
  for (const s of sites) {
    for (const t of s.tokens) {
      t.routeId = s.id + '-' + t.id
      const r = routeIndex.get(t.routeId)
      t.registered = !!r
      if (!t.models.length && r && r.models.length) t.models = r.models.slice()
      if (!t.models.includes(t.defaultModel)) t.defaultModel = t.models[0] || ''
      const c = creds.find((x) => x.name === t.keyVar)
      t.hasKey = !!(c && c.value)
      t.keyMasked = c ? c.masked : ''
      // 列表里显示的那一列识别名（前4 + 后4）。用户自己填了 label 就用 label。
      t.keyHint = c && c.value ? hint(c.value) : ''
      t.name = t.label || t.keyHint || t.routeId
    }
  }

  // 激活：生效配置说了算；配置里没有（刚改完还没保存）才用存档的
  const st = store.active && typeof store.active === 'object' ? store.active : {}
  let aSite = activeRoute ? splitRoute(activeRoute).site : String(st.site || '').trim()
  let aToken = activeRoute ? splitRoute(activeRoute).token : String(st.token || '').trim()
  let site = sites.find((x) => x.id === aSite)
  let tok = site && site.tokens.find((x) => x.id === aToken)
  if (!site) site = sites.find((x) => x.id === String(st.site || '').trim())
  if (site && !tok) tok = site.tokens.find((x) => x.id === String(st.token || '').trim())
  if (site && !tok) tok = site.tokens[0]
  if (!site) { site = sites[0]; tok = site && site.tokens[0] }
  if (tok && activeModel && tok.models.includes(activeModel)) tok.defaultModel = activeModel

  // 「同一时间只有一把启用」：存档里的启用位可能与生效配置不同步（手改过、或换来版本），
  // 以生效配置为准对齐一下，免得列表里同时亮起两把「启用」。只改内存，不动盘。
  for (const s of sites) for (const t of s.tokens) t.enabled = !!(site && tok && s === site && t === tok)

  return {
    sites,
    active: site && tok
      ? { site: site.id, token: tok.id, routeId: tok.routeId, model: tok.defaultModel }
      : { site: '', token: '', routeId: '', model: '' },
    migrated,
  }
}

function readCredentials() {
  const out = []
  for (const line of readText(KEYS).split('\n')) {
    const m = /^export\s+([A-Za-z_][A-Za-z0-9_]*)=(['"]?)(.*)\2\s*$/.exec(line)
    if (m) out.push({ name: m[1], value: m[3], masked: mask(m[3]) })
  }
  return out
}

function readServices() {
  const names = ['dsh-web', 'dsh-lan', 'dsh-ctl']
  const res = []
  for (const n of names) {
    let raw = ''
    try {
      raw = execSync(BIN + '/sv status ' + n + ' 2>&1', { encoding: 'utf8', timeout: 5000, env: CHILD_ENV })
    } catch (e) { raw = String((e && e.stdout) || '') + String((e && e.stderr) || '') }
    raw = raw.trim()
    res.push({
      name: n,
      installed: fs.existsSync(SVDIR + '/' + n),
      up: /^run:/.test(raw),
      raw,
    })
  }
  return res
}

function serviceLog(name, lines) {
  const f = PREFIX + '/var/log/sv/' + name + '/current'
  const s = readText(f)
  if (!s) return '(没有日志：' + f + ')'
  return s.split('\n').slice(-Math.max(1, Math.min(400, lines || 60))).join('\n')
}

async function readToken() {
  const r = await runFile(BIN + '/dsh-web-url', [], 15000)
  return /token=[A-Za-z0-9_-]+/.exec(r.out)
    ? r.out.trim().split('\n').pop()
    : ''
}

async function readVersion() {
  const r = await runFile(BIN + '/dsh', ['--version'], 20000)
  return (r.out || '').trim().split('\n')[0]
}

/* ------------------------------------------------------- dsh 版本更新（只读探测） */

/**
 * 本地装着的 dsh 版本 —— 直接读 package.json。
 *
 * 不走 `dsh --version`：那要起一个 node 进程（Termux 上冷启动 1~3 秒），
 * 而版本号就写在文件里，读一下是微秒级的事。`installedVersion()` 还与
 * npm 的落盘结果严格一致，拿来做「升没升上去」的判据比跑进程更可靠。
 */
function installedVersion() {
  try {
    const j = JSON.parse(readText(DSH_PKG_JSON))
    return String(j.version || '')
  } catch { return '' }
}

function flockNativeOk() {
  try { return fs.statSync(FLOCK_NATIVE).size > 0 } catch { return false }
}

/** 极简 HTTPS GET → JSON。只用于打 npm registry，超时就放弃。 */
function httpsJson(url, timeoutMs) {
  return new Promise((resolve) => {
    let req
    try {
      req = https.get(url, {
        timeout: timeoutMs || 12000,
        headers: { accept: 'application/json', 'user-agent': 'dsh-ctl-gateway/1.0' },
      }, (res) => {
        if (res.statusCode !== 200) { res.resume(); return resolve({ ok: false, code: res.statusCode }) }
        let b = ''
        res.setEncoding('utf8')
        res.on('data', (d) => { b += d; if (b.length > 4e6) req.destroy() })
        res.on('end', () => {
          try { resolve({ ok: true, json: JSON.parse(b) }) } catch { resolve({ ok: false, why: '返回不是 JSON' }) }
        })
      })
    } catch (e) { return resolve({ ok: false, why: e.message }) }
    req.on('error', (e) => resolve({ ok: false, why: e.message }))
    req.on('timeout', () => { req.destroy(); resolve({ ok: false, why: '超时' }) })
  })
}

/**
 * 查 @deepseek-ai/dsh 的 dist-tags。
 *
 * 打的是 registry 的**小端点** `/-/package/<pkg>/dist-tags`（几百字节），
 * 而不是整包文档（那个几百 KB）。设备实测 1~2 秒。
 * 官方源失败就退回 npmmirror —— 国内网络下这个兜底经常决定成败。
 */
async function fetchDistTags(timeoutMs) {
  const regs = ['https://registry.npmjs.org', 'https://registry.npmmirror.com']
  const tried = []
  for (const reg of regs) {
    const url = reg + '/-/package/' + encodeURIComponent(DSH_PKG) + '/dist-tags'
    const t0 = Date.now()
    const r = await httpsJson(url, timeoutMs)
    if (r.ok && r.json && (r.json.latest || r.json.next)) {
      return { ok: true, tags: r.json, registry: reg, ms: Date.now() - t0 }
    }
    tried.push(reg.replace(/^https:\/\//, '') + ' → ' + (r.why || ('HTTP ' + r.code)))
  }
  return { ok: false, tried }
}

const CHANNELS = ['latest', 'next', 'alpha']
function pickChannel(v) {
  const c = clean(v)
  return CHANNELS.indexOf(c) >= 0 ? c : 'latest'
}

/** 只读：现在装着什么、远端有什么。安全的那个按钮就是这个。 */
async function apiDshCheck(body) {
  const cur = installedVersion()
  const channel = pickChannel(body && body.channel)
  const r = await fetchDistTags(20000)
  if (!r.ok) {
    return {
      ok: !!cur, current: cur, channel, latest: '', tags: {}, hasUpdate: false,
      out: '查不到远端版本（' + (r.tried || []).join('；') + '）',
    }
  }
  const latest = String(r.tags[channel] || r.tags.latest || '')
  return {
    ok: true,
    current: cur,
    channel,
    latest,
    tags: r.tags,
    hasUpdate: !!(cur && latest && cur !== latest),
    registry: r.registry,
    ms: r.ms,
    patcher: fs.existsSync(PATCHER),
    flockOk: flockNativeOk(),
  }
}

/**
 * dsh 生命周期的共用引擎：装包 → 重打 JS 补丁 → 局域网补丁 → flock → 起服务 → 验证。
 *
 * 两个入口共用这一条链：
 *   install    （安装器在网关就绪后调用，dsh 还没有）   before=''
 *   dshupgrade （面板「更新」换版本）                   before=旧版 → 先改名备份，装失败回滚
 *
 * 为什么装/升级之后必须重打补丁：`@deepseek-ai/dsh` 是为 glibc Linux/macOS 构建的，
 * Termux（Android/bionic）上有几处硬不兼容（见 patches.py 顶部）。补丁直接改
 * node_modules 里的源码，而 `npm install -g` 会把整个包目录换成官方版 ——
 * 补丁全丢、flock 那个本地编译的 .node 也没了。装完不补 = 服务起不来。
 *
 * 回滚用**改名**而不是复制：305MB 的目录 `mv` 是瞬时的，`cp -a` 要几十秒。
 * 备份放在同一父目录下（同一文件系统），失败时删掉装坏的再改回来即可。
 *
 * 全程往 job 里推输出（runStream 逐行实时）：安装器在终端轮询、面板在网页轮询
 * /ctl/api/jobstatus，看到的都是同一份现场。
 */
async function provisionDsh(job, want) {
  const before = installedVersion()

  // 1) 备份：把整个 scope 目录改名挪走（瞬时）。全新安装时没有旧包，跳过。
  const bak = DSH_SCOPE + '.bak-' + Date.now()
  let renamed = false
  try {
    if (fs.existsSync(DSH_SCOPE)) {
      fs.renameSync(DSH_SCOPE, bak)
      renamed = true
      jobLine(job, '◆ 备份 ' + DSH_SCOPE + ' → ' + bak + '（瞬时改名；装失败可退回 ' + before + '）')
    }
  } catch (e) {
    return { ok: false, out: '备份失败，没敢继续：' + e.message }
  }

  // 2) 装新版。这一步单独带编译标志：0.2.0+ 的 koffi 要现编，而 bionic 上
  //    statx() 必须 -D_GNU_SOURCE + API>=30 才可见（见 NPM_BUILD_ENV 那段注释）。
  const nr = await runStream(job, NPM_BIN, ['install', '-g', DSH_PKG + '@' + want],
    { timeoutMs: NPM_UPGRADE_TIMEOUT, env: NPM_BUILD_ENV })
  const nowVer = installedVersion()
  if (nr.code !== 0 || nowVer !== want) {
    // 回滚：删掉装坏的，把备份改回来，重启服务
    if (fs.existsSync(DSH_SCOPE)) fs.rmSync(DSH_SCOPE, { recursive: true, force: true })
    if (renamed && fs.existsSync(bak)) fs.renameSync(bak, DSH_SCOPE)
    await runStream(job, BIN + '/sv', ['restart', 'dsh-web'], { timeoutMs: 30000 })
    await sleep(4000)
    await runStream(job, BIN + '/sv', ['status', 'dsh-web'], { timeoutMs: 10000 })
    return {
      ok: false,
      out: '装 ' + want + ' 这一步没成（npm 退出码 ' + nr.code + '，落盘版本 ' + (nowVer || '读不到') +
        '）。已自动回滚到 ' + before + '。',
      rolledBack: true, from: before, to: want, state: await buildState(),
    }
  }

  // 3) 补丁链（patches.py → LAN 设置补丁 → flock 原生插件）
  const pc = await runPatchChain(job)
  if (pc.patchFailed) {
    return {
      ok: false,
      out: '补丁没全打好（patches.py 退出码 ' + pc.code + '）。上游可能改了被补丁的那几个文件。\n' +
        '装坏的包还在（补丁只打了一半），需要手动处理，或跑卸载脚本（uninstall.sh）清掉再来。',
      from: before, to: want, state: await buildState(),
    }
  }

  // 4) 起 dsh-web 服务（服务目录在就 restart，不在就建出来再 up）
  const svcErr = await ensureWebService(job)
  if (svcErr) {
    return Object.assign({}, svcErr, { from: before, to: want, state: await buildState() })
  }

  // 5) 取令牌 + 版本，拼出可直接点的登录链接
  let tokenUrl = ''
  for (let i = 0; i < 10 && !tokenUrl; i++) {
    if (i) await sleep(2000)
    tokenUrl = await readToken()
  }
  const ver = await readVersion()
  jobLine(job, '✓ dsh --version → ' + ver)
  const tokPart = /token=([A-Za-z0-9_-]+)/.exec(tokenUrl)
  const ip = lanIp()
  const appUrl = ip && tokPart ? 'http://' + ip + ':' + LISTEN_PORT + '/app?token=' + tokPart[1] : ''

  return {
    ok: true,
    out: '已从 ' + (before || '无') + ' 装到 ' + want + '，补丁已重打，dsh-web 已重启并验证。' +
      (appUrl ? '\n登录链接（点开就直接进 dsh 主界面）：' + appUrl : ''),
    from: before, to: want, state: await buildState(), appUrl,
  }
}

/**
 * 补丁链：patches.py → LAN 设置补丁 → flock 原生插件。
 * install / repair / upgrade 三条生命周期的共用中段 —— 装完包（或包本来就在）
 * 之后干的事完全一样：补丁打回去、LAN 那条小补丁补上、flock 插件缺了现编。
 *
 * 返回 {patchFailed, code}：patches.py 的退出码就是判据
 * （0 全成 / 1 有补丁没打成 / 2 环境问题）。后两步一律非致命。
 */
async function runPatchChain(job) {
  const pr = await runStream(job, BIN + '/python3', [PATCHER], { timeoutMs: 180000 })
  if (pr.code !== 0) return { patchFailed: true, code: pr.code }

  // 局域网设置补丁：只让 LAN 下「设置」页可用，不成服务也能跑
  const lr = await runStream(job, BIN + '/dsh-patch-lan-settings', [], { timeoutMs: 60000 })
  if (lr.code !== 0) {
    jobLine(job, '⚠ dsh-patch-lan-settings 没成（非致命，继续）：' +
      String(lr.out || '').trim().split('\n')[0])
  }

  // flock 原生插件：npm 重装会把它冲掉，缺了就现编
  if (!flockNativeOk() && fs.existsSync(FLOCK_BUILD)) {
    await runStream(job, BIN + '/bash', [FLOCK_BUILD], { timeoutMs: 600000 })
  }
  return { patchFailed: false }
}

/**
 * 起 dsh-web 服务：runit 目录在位就 restart，不在就跑 install-web-service.sh 建出来再 up。
 * install / repair / upgrade 共用。sv 动作后不是立刻 run: 是常态（runsv 要拉进程），
 * 所以重试 8 轮、每轮间隔 2.5 秒；run: 之后还要端口真的应答才算起来。
 *
 * @returns {null | {ok:false, out:string}} null = 服务已起来；否则 = 失败定妆照（调用方补 state）
 */
async function ensureWebService(job) {
  const svcExisted = fs.existsSync(SVD)
  if (!svcExisted) {
    const ir = await runStream(job, BIN + '/bash', [INSTALL_WEB_SERVICE_SH], { timeoutMs: 300000 })
    if (ir.code !== 0) {
      return { ok: false, out: '建 dsh-web 服务目录失败（install-web-service.sh 退出码 ' + ir.code + '）。' }
    }
  }
  const act = svcExisted ? 'restart' : 'up'
  let up = false
  for (let i = 0; i < 8 && !up; i++) {
    if (i) await sleep(2500)
    await runStream(job, BIN + '/sv', [act, 'dsh-web'], { timeoutMs: 30000 })
    await sleep(2500)
    const sr = await runStream(job, BIN + '/sv', ['status', 'dsh-web'], { timeoutMs: 10000 })
    up = /^run:/.test(String(sr.out || '').trim())
    if (!up) jobLine(job, '⚠ sv ' + act + ' dsh-web 后还不是 run:，重试 ' + (i + 1) + '/8')
  }
  if (!up) {
    return { ok: false, out: '服务起不来（sv status 不是 run:）。补丁已打，dsh-web 需要手动排查：看 $PREFIX/var/log/sv/dsh-web/current。' }
  }
  if (!(await waitUp(UP_HOST, UP_PORT, 120000))) {
    return { ok: false, out: 'sv 显示 run: 但端口 ' + UP_PORT + ' 不应答。服务可能还在启动，等一会儿再试。' }
  }
  return null
}

/**
 * 把长任务丢到后台跑：API 立刻返回 jobId，安装器 / 面板轮询 /ctl/api/jobstatus 看现场。
 * 同一时间只允许一个任务（startJob 里已经拦截并发）。
 */
function startLifecycleJob(kind, title, run) {
  const started = startJob(kind, title)
  if (!started.ok) return started
  const job = started.job
  ;(async () => {
    try {
      finishJob(job, await run(job))
    } catch (e) {
      finishJob(job, { ok: false, out: '任务炸了：' + String((e && e.stack) || e) })
    }
  })()
  return { ok: true, jobId: job.id, job: jobSnapshot() }
}

/**
 * 更新 dsh：校验入参 → 后台跑 provisionDsh。
 * 面板拿 jobId 轮询 jobstatus，弹窗里实时滚日志。
 */
async function apiDshUpgrade(body) {
  if (!fs.existsSync(PATCHER)) {
    return { ok: false, out: '补丁器缺失：' + PATCHER + '\n它随网关一起装到设备；缺了就没法在升级后把补丁补回来 —— 为免升级后起不来，这里直接不动手。' }
  }
  const before = installedVersion()
  if (!before) {
    return { ok: false, out: 'dsh 还没装（读不到 ' + DSH_PKG_JSON + '）。\n这一趟请跑安装器（install-gateway.sh）。' }
  }

  const channel = pickChannel(body && body.channel)
  const forced = !!(body && body.force)
  const want0 = clean(body && body.version, 64)
  const r = await fetchDistTags(20000)
  const want = want0 || (r.ok ? String(r.tags[channel] || '') : '')
  if (!want) {
    return { ok: false, out: '拿不到目标版本号（远端查不到，也没手动指定）。' + (r.ok ? '' : (r.tried || []).join('；')) }
  }
  if (!/^\d+\.\d+\.\d+/.test(want)) return { ok: false, out: '版本号看起来不对：' + want }
  if (before === want && !forced) {
    return { ok: false, out: '现在装的就是 ' + want + '。要原地重跑一遍（重打补丁、重建插件），勾上「强制重装」再来。', current: before }
  }

  return startLifecycleJob('dshupgrade', '更新 dsh → ' + want,
    (job) => provisionDsh(job, want))
}

/**
 * 安装 dsh：由安装器（install-gateway.sh）在网关就绪后调用，dsh 本体不存在时从这里装。
 * 版本选择：手填 > 通道默认（默认 latest）。
 */
async function apiInstall(body) {
  if (fs.existsSync(DSH_PKG_JSON)) {
    return { ok: false, out: 'dsh 已经装了（' + installedVersion() + '）。要换版本用控制台的「更新」；补丁被冲掉就用「更新」里的强制重装。' }
  }
  if (!fs.existsSync(NPM_BIN)) {
    return { ok: false, out: '没有 npm（' + NPM_BIN + '）。先在 Termux 里 pkg install nodejs 再来。' }
  }
  if (!fs.existsSync(PATCHER)) return { ok: false, out: '补丁器缺失：' + PATCHER }
  if (!fs.existsSync(INSTALL_WEB_SERVICE_SH)) {
    return { ok: false, out: '服务安装脚本缺失：' + INSTALL_WEB_SERVICE_SH }
  }

  const channel = pickChannel(body && body.channel)
  const want0 = clean(body && body.version, 64)
  let want = want0
  if (!want) {
    const r = await fetchDistTags(20000)
    want = r.ok ? String(r.tags[channel] || r.tags.latest || '') : ''
    if (!want) {
      return { ok: false, out: '拿不到要装的版本号（远端查不到，也没手动指定）。' + (r.ok ? '' : (r.tried || []).join('；')) }
    }
  }
  if (!/^\d+\.\d+\.\d+/.test(want)) return { ok: false, out: '版本号看起来不对：' + want }

  return startLifecycleJob('install', '安装 dsh ' + want,
    (job) => provisionDsh(job, want))
}

/**
 * 修复 dsh：包在但「坏了」—— 补丁被冲掉 / 服务起不来 / 升级中断后收尾。
 *
 * 刻意**不挪包也不走 npm**：包没换就没必要冒险动 npm 的账（升级链里那步改名备份 +
 * 回滚是为换版本准备的，修复根本不换版本）。只做「重打补丁 + 起服务」两件事 ——
 * 比强制重装快（不下载 300MB），也比它安全（npm 账上一笔都不动）。
 */
async function apiRepair() {
  if (!fs.existsSync(PATCHER)) {
    return { ok: false, out: '补丁器缺失：' + PATCHER + '。重跑 install-gateway.sh 把生命周期四件套补回来。' }
  }
  if (!fs.existsSync(DSH_PKG_JSON)) {
    return { ok: false, out: 'dsh 还没装（读不到 ' + DSH_PKG_JSON + '）。装 dsh 走控制台的安装向导，或重跑 install-gateway.sh。' }
  }
  return startLifecycleJob('repair', '修复 dsh（重打补丁 + 起服务）', repairDsh)
}

async function repairDsh(job) {
  const before = installedVersion()
  jobLine(job, '◆ 不挪包、不走 npm，只重打补丁 + 起服务（当前版本 ' + before + '）')

  const pc = await runPatchChain(job)
  if (pc.patchFailed) {
    return {
      ok: false,
      out: '补丁没全打好（patches.py 退出码 ' + pc.code + '）。上游可能改了被补丁的那几个文件；' +
        '要换版本走「更新」，或卸载后重装。',
      state: await buildState(),
    }
  }

  const svcErr = await ensureWebService(job)
  if (svcErr) return Object.assign({}, svcErr, { state: await buildState() })

  const ver = await readVersion()
  jobLine(job, '✓ dsh --version → ' + ver)
  return {
    ok: true,
    out: '补丁已重打，dsh-web 已起来并验证（版本 ' + ver + '）。',
    state: await buildState(),
  }
}

/**
 * 卸载：把 uninstall.sh 复制到 TMPDIR，**detached** 跑。
 *
 * 为什么必须 detached + 复制：网关自己就是被删的对象 —— uninstall 会 sv down
 * dsh-ctl 把它杀掉、还会删 share/dsh-ctl（脚本本身在那里）。在 HTTP 请求里等它，
 * 响应还没写回连接就断了；原地跑会把自己删到一半卡住。所以：
 *   · 复制到 $TMPDIR/dsh-uninstall-<ts>/（TMPDIR 不在卸载清单里）
 *   · spawn(..., { detached: true }) + unref()：子进程进自己的进程组，网关被杀
 *     它也不死，慢慢删 300MB 的包
 *   · 输出追加进 $TMPDIR/dsh-uninstall.log，网关活着时每秒 tail 推进 job 现场
 *   · run.sh 在脚本退出后把退出码落码（exit.code）—— 网关要是被杀了，重启时
 *     靠它把账对上（reconcileJob / resumeDetached）
 *
 * 参数：默认 `-y --dsh`（把 npm 包一起卸，否则「继续安装」会被旧包挡住）；
 * `body.all` = `-y --all`（连 ~/.dsh 用户数据一起删，「从手机上抹掉」那一档）。
 */
async function apiUninstall(body) {
  if (!fs.existsSync(UNINSTALL_SH)) {
    return { ok: false, out: '卸载脚本缺失：' + UNINSTALL_SH + '。手工执行 install/uninstall.sh 也能卸。' }
  }
  const started = startJob('uninstall', (body && body.all) ? '卸载（含用户数据）' : '卸载 dsh-termux 方案')
  if (!started.ok) return started
  const job = started.job
  const all = !!(body && body.all)

  let dir
  try {
    // 1) 复制卸载脚本 + 生成 run.sh（全用位置参数，脚本串里不拼任何用户输入）
    dir = TMPDIR + '/dsh-uninstall-' + Date.now()
    fs.mkdirSync(dir, { recursive: true })
    fs.copyFileSync(UNINSTALL_SH, dir + '/uninstall.sh')
    fs.writeFileSync(dir + '/run.sh',
      '#!/bin/sh\n' +
      '# 由 dsh-ctl-gateway 生成（' + dir + '/run.sh）\n' +
      '# 职责：detached 跑卸载脚本，退出后把退出码落码 ——\n' +
      '# 网关可能在任务跑的过程中被杀（sv down dsh-ctl），重启后靠落码对账。\n' +
      'SCRIPT="$1"; MARK="$2"; shift 2\n' +
      'bash "$SCRIPT" "$@"\n' +
      'echo $? >"$MARK"\n', 'utf8')
    fs.chmodSync(dir + '/run.sh', 0o755)

    // 2) 日志清干净：旧卸载的尾部混进本次现场只会误导
    try { fs.writeFileSync(TMPDIR + '/dsh-uninstall.log', '') } catch {}
    const logFd = fs.openSync(TMPDIR + '/dsh-uninstall.log', 'a')
    job.detach = {
      dir, script: dir + '/uninstall.sh', log: TMPDIR + '/dsh-uninstall.log',
      mark: dir + '/exit.code', pushed: 0, buf: '',
    }
    const args = [dir + '/run.sh', dir + '/uninstall.sh', dir + '/exit.code', '-y', all ? '--all' : '--dsh']
    jobLine(job, '$ bash ' + args.join(' '))

    // 3) detached 起来：stdio 全落日志文件（fd 继承给子进程，网关死了也能继续写）
    const child = spawn(BIN + '/bash', args, {
      detached: true,
      stdio: ['ignore', logFd, logFd],
      env: CHILD_ENV,
    })
    child.unref()
    job.pid = child.pid
    jobLine(job, '◆ 卸载在后台开始（PID ' + child.pid + '）：网关会被 sv down 杀掉，面板轮询会断 —— 这是正常的，不是故障')
    persistJob(true)

    // 4) 网关还活着时：子进程退出事件是主信号（run.sh 此时装好码了）
    child.on('error', (e) => {
      jobLine(job, '✗ 启动卸载子进程失败：' + e.message)
      finishJob(job, { ok: false, out: '启动卸载子进程失败：' + e.message })
      stopSupervise(job)
    })
    child.on('exit', (code) => {
      if (job.status === 'running') finishDetached(job, typeof code === 'number' ? code : 1)
    })

    // 5) 兜底盯着（兼做「网关被杀后重启」的恢复入口）
    superviseDetached(job)
  } catch (e) {
    finishJob(job, { ok: false, out: '准备卸载失败：' + String((e && e.stack) || e) })
    return { ok: false, out: String((e && e.message) || e) }
  }

  return {
    ok: true, jobId: job.id, job: jobSnapshot(),
    out: '卸载已在后台开始。网关自己就是被删的对象 —— 网页会断连，别当故障；' +
      '确认结果看日志：' + TMPDIR + '/dsh-uninstall.log',
  }
}

/** 安装器 / 面板轮询用：当前任务的现场快照。 */
async function apiJobStatus() {
  return { ok: true, job: jobSnapshot() }
}


/** 长输出只留头尾 —— npm 能吐几千行，全塞回面板既没用又卡。 */
function clipTail(s, max) {
  const t = String(s == null ? '' : s)
  if (t.length <= max) return t
  const half = Math.floor(max / 2)
  return t.slice(0, half) + '\n…（中间省略 ' + (t.length - max) + ' 字符）…\n' + t.slice(-half)
}

/* ------------------------------------------------------- 任务运行器（长任务）
 *
 * 安装 / 更新都是长任务：npm 装包在 Termux 上要几分钟。HTTP 请求不能一直
 * 挂着，所以一律改成：
 *   API 立刻返回 jobId → 后台跑 → 输出逐行实时收进 JOB.lines
 *   → 安装器 / 面板轮询 /ctl/api/jobstatus 拿现场。
 * 同一时间只允许一个任务（设备上并行两个 npm install 会互相踩），第二个拒绝。
 *
 * **job 落盘**：任务现场（steps / lines / 运行中状态 / detached 子进程的信息）
 * 同步写进 JOB_FILE。为什么要：
 *   · 面板晚几十秒来看、或网关被重启，jobstatus 仍回得出最后一个任务
 *     （「完成态保留」以前纯内存，重启就没了）
 *   · 卸载是 detached 的：网关自己就是被删的对象，sv down 会杀掉它。子进程
 *     不死（自己的进程组），退出码由 run.sh 落码 —— 网关重启后（或 reinstall
 *     后）能把账对上：接着盯、或按退出码结案。
 *   · **并发护栏跨重启有效**：重启前有个卸载在跑，重启后新来的 install 依然
 *     被拒（「另一个任务正在跑」）—— 内存版护栏重启即失效，正是 16:00 卸载 /
 *     16:04 修复重建撞车那一类事故的入口。
 * 落盘失败一律不影响任务本身（catch 吞掉）：最坏只是重启后丢现场，任务照跑。
 */
let JOB = null

function startJob(kind, title) {
  if (JOB && JOB.status === 'running') {
    return { ok: false, out: '另一个任务正在跑（' + JOB.title + '，已开始 ' +
      Math.round((Date.now() - JOB.startedAt) / 1000) + ' 秒）。等它完事再点。' }
  }
  JOB = {
    id: kind + '-' + Date.now(), kind, title, status: 'running',
    steps: [], lines: [], startedAt: Date.now(), result: null,
    pid: 0,          // detached 子进程的 PID（只有 uninstall 用）
    detach: null,    // {dir, script, log, mark, pushed, buf} —— 卸载专用的恢复信息
  }
  jobLine(JOB, '◆ ' + title)
  persistJob(true)
  return { ok: true, job: JOB }
}

/** 收一行进现场：剔 \r（进度条 / CRLF 会把一行劈成多行），400 行封顶丢头留尾。 */
function jobLine(job, s) {
  if (!job) return
  const line = String(s == null ? '' : s).replace(/\r/g, '')
  if (!line) return
  job.lines.push(line)
  if (job.lines.length > 400) job.lines = job.lines.slice(-400)
  persistJob()
}

/** 一步的定妆照（命令 / 退出码 / 输出摘要）：runStream 跑完一步 push 一次。 */
function jobStep(job, cmd, code, out) {
  if (!job) return
  job.steps.push({ cmd, code, out: clipTail(out, 4000) })
  persistJob()
}

/** 给安装器 / 面板轮询的快照：最近 160 行现场 + 步骤 + 耗时 + 最终结果。 */
function jobSnapshot() {
  if (!JOB) return null
  return {
    id: JOB.id, kind: JOB.kind, title: JOB.title, status: JOB.status,
    steps: JOB.steps, lines: JOB.lines.slice(-160),
    elapsedS: Math.round((Date.now() - JOB.startedAt) / 1000), result: JOB.result,
  }
}

function finishJob(job, result) {
  job.status = result && result.ok ? 'done' : 'failed'
  job.result = result || { ok: false, out: '（无结果）' }
  jobLine(job, (job.status === 'done' ? '✓ 完成' : '✗ 失败') +
    '（共 ' + Math.round((Date.now() - job.startedAt) / 1000) + ' 秒）')
}

/**
 * 把 JOB 写进 JOB_FILE。防抖 300ms：npm 一秒吐几百行，逐行同步写盘没有意义；
 * 开始 / 步骤 / 结束这些里程碑强制立即写（force=true）。
 * 原子写：先 .tmp 再 rename —— 被杀到一半也只可能是旧文件或新文件，不会是半截 JSON。
 */
let persistDue = false
function persistJob(force) {
  if (!JOB) return
  if (!force) {
    if (persistDue) return
    persistDue = true
    setTimeout(() => { persistDue = false; persistJob(true) }, 300)
    return
  }
  persistDue = false
  try {
    const tmp = JOB_FILE + '.tmp'
    fs.writeFileSync(tmp, JSON.stringify(JOB) + '\n', 'utf8')
    fs.renameSync(tmp, JOB_FILE)
  } catch {}   // 落盘失败不杀任务：最坏重启后丢现场
}

/**
 * 启动时把盘上的任务对上账（job 落盘的读侧）。
 *   · done/failed → 直接恢复成「最后一个任务」：jobstatus 照常回看现场
 *   · running + detach（卸载）→ 子进程不随网关死：退出码落码在了就结案，
 *     PID 还活着就接着盯现场，都没有就标中断
 *   · running 无 detach（install/repair/upgrade）→ 网关一死输出流就断了，
 *     子进程（npm）可能仍在后台跑完，但现场续不上：标「中断」，结果以 dsh
 *     当前状态为准（看版本行 / 服务状态）
 * 记录有任何看不懂的字段就当没有（防手改 / 跨版本）。
 */
function reconcileJob() {
  let rec = null
  try { rec = JSON.parse(readText(JOB_FILE)) } catch { return }
  if (!rec || typeof rec !== 'object' || !rec.kind || !Number(rec.startedAt)) return
  if (!Array.isArray(rec.lines) || !Array.isArray(rec.steps)) return

  JOB = {
    id: String(rec.id || rec.kind + '-restored'), kind: String(rec.kind),
    title: String(rec.title || rec.kind),
    status: rec.status === 'done' ? 'done' : rec.status === 'failed' ? 'failed' : 'running',
    steps: rec.steps, lines: rec.lines.slice(-400),
    startedAt: Number(rec.startedAt), result: rec.result || null,
    pid: Number(rec.pid) || 0,
    detach: rec.detach && typeof rec.detach === 'object' && rec.detach.script ? rec.detach : null,
  }
  if (JOB.status !== 'running') return         // 已结束：留着给 jobstatus 回看
  if (JOB.detach) return resumeDetached(JOB)
  interruptJob(JOB, '网关在任务运行中被重启。子进程（npm 等）不随网关死，可能已在后台跑完，' +
    '但输出现场续不上了 —— 结果以 dsh 当前状态为准：看版本行与服务状态。')
}

/** 运行中的任务被网关重启打断：诚实标成失败，不假装完成也不悄悄丢失。 */
function interruptJob(job, msg) {
  job.status = 'failed'
  job.result = { ok: false, out: '⚠ 任务中断：' + msg }
  jobLine(job, '⚠ 网关重启：任务现场到此中断')
  persistJob(true)
}

/**
 * 恢复一个 detached 卸载任务（网关重启时盘上还留着 running 状态）。
 * 优先级：退出码落码（子进程已跑完）> PID 还活着（接着盯）> 都没有（中断）。
 * PID 复用是这条判据的理论风险 —— 只有刚重启的几秒内会查，且最坏后果只是
 * 把一个不相关的进程「当成」卸载子进程盯着，超时后自动放弃。
 */
function resumeDetached(job) {
  const code = readExitMark(job.detach.mark)
  if (code !== null) {
    jobLine(job, '◆ 网关重启时卸载已跑完，按落码结案')
    return finishDetached(job, code)
  }
  if (pidAlive(job.pid)) {
    jobLine(job, '◆ 网关重启：卸载子进程（PID ' + job.pid + '）仍在跑，接着盯现场')
    tailInto(job, job.detach.log)     // 重启前没推完的日志先补上
    return superviseDetached(job)
  }
  interruptJob(job, '卸载子进程（PID ' + job.pid + '）已不在，也没留下退出码。' +
    '人工确认：ls $PREFIX/share/dsh-ctl 与 dsh 包目录，看 ' + job.detach.log + '。')
}

/** PID 还在不在（0 信号只是探测，不打断进程）。 */
function pidAlive(pid) {
  if (!pid) return false
  try { process.kill(pid, 0); return true } catch { return false }
}

/** run.sh 落的退出码；文件不在 / 内容不是数字都算「还没落」。 */
function readExitMark(p) {
  const s = readText(p).trim()
  return /^-?\d+$/.test(s) ? Number(s) : null
}

function stopSupervise(job) {
  if (job && job.detachedTimer) { clearInterval(job.detachedTimer); job.detachedTimer = null }
}

/**
 * 接着盯一个 detached 卸载子进程（网关重启后，或任务刚起来时）。
 * 每秒三件事：退出码落码了吗 → PID 还在吗 → 日志新出来的行推进现场。
 * 15 分钟还没完就不再盯（子进程仍在后台跑，不杀它 —— rm -rf 杀到一半更糟）。
 */
function superviseDetached(job) {
  if (job.detachedTimer) return
  const d = job.detach
  const t0 = Date.now()
  job.detachedTimer = setInterval(() => {
    const code = readExitMark(d.mark)
    if (code !== null) return finishDetached(job, code)
    if (!pidAlive(job.pid)) {
      // 进程没了却没落码：被外部信号干掉了（不是脚本自己退的）
      return finishDetached(job, null)
    }
    tailInto(job, d.log)
    if (Date.now() - t0 > NPM_UPGRADE_TIMEOUT) {
      stopSupervise(job)
      finishJob(job, {
        ok: false,
        out: '卸载超过 ' + Math.round(NPM_UPGRADE_TIMEOUT / 60000) + ' 分钟还没完，网关侧不再盯现场。' +
          '子进程仍在后台跑，回设备看日志确认：' + d.log,
      })
    }
  }, 1000)
}

/**
 * detached 卸载结案：退出码 + 日志尾部拼成结果。
 * code === null 表示进程消失但没留下退出码（被 kill 等），算失败但说明白原因。
 */
function finishDetached(job, code) {
  if (job.status !== 'running') return
  stopSupervise(job)
  const d = job.detach || {}
  const tail = d.log ? tailFile(d.log, 40) : ''
  const head = code === 0
    ? '✓ 卸载完成。'
    : code === null
      ? '✗ 卸载进程结束了，但没留下退出码（可能被外部信号杀掉）。'
      : '✗ 卸载脚本退出码 ' + code + '（有残留或参数不对，看日志）。'
  finishJob(job, {
    ok: code === 0,
    out: head + '\n如果你还能看到这一行，说明网关活着 —— 卸载本该把它自己也删掉（sv down dsh-ctl），' +
      '没删掉多半是卸载中断了。确认结果：' + (d.log || '（无日志路径）') +
      (tail ? '\n--- 日志尾部 ---\n' + tail : ''),
  })
}

/** 读日志文件的最后 N 行。 */
function tailFile(p, n) {
  const s = readText(p)
  if (!s) return ''
  return s.split('\n').filter(Boolean).slice(-Math.max(1, n)).join('\n')
}

/**
 * 把日志新长出来的行推进 job.lines。
 * 按字节偏移记进度（d.pushed），半行攒在 d.buf 里等下一次补齐 —— 直接切行会把
 * 一行输出劈成两行推进现场。
 */
function tailInto(job, file) {
  const d = job.detach
  if (!d) return
  const txt = readText(file)
  if (!txt || txt.length <= (d.pushed || 0)) return
  d.buf = (d.buf || '') + txt.slice(d.pushed || 0)
  d.pushed = txt.length
  let i
  while ((i = d.buf.indexOf('\n')) >= 0) {
    jobLine(job, d.buf.slice(0, i))
    d.buf = d.buf.slice(i + 1)
  }
}

/**
 * 跑子进程，stdout/stderr 逐行实时塞进 job.lines —— 轮询方（安装器或面板）看得见进度，
 * 不是干等一个promise。跨 chunk 的半行用 buf 拼好再切；累计输出 2MB 封顶
 * 丢头留尾（报错都在尾部，头部的下载条没用）。
 * 超时先 SIGTERM，3 秒不退再 SIGKILL，退出码记 124。
 */
function runStream(job, file, args, opts) {
  opts = opts || {}
  const cmd = file + ' ' + (args || []).map(String).join(' ')
  return new Promise((resolve) => {
    let child
    try {
      child = spawn(file, args, { env: opts.env || CHILD_ENV, stdio: ['ignore', 'pipe', 'pipe'] })
    } catch (e) {
      jobLine(job, '$ ' + cmd)
      jobStep(job, cmd, 127, '执行失败: ' + e.message)
      return resolve({ code: 127, out: '执行失败: ' + e.message })
    }
    jobLine(job, '$ ' + cmd)
    let buf = ''
    let acc = ''
    let timedOut = false
    let done = false
    const finish = (code, out) => {
      if (done) return
      done = true
      clearTimeout(timer)
      jobStep(job, cmd, code, out)
      resolve({ code, out })
    }
    const onChunk = (d) => {
      acc += String(d)
      if (acc.length > 2 * 1024 * 1024) acc = acc.slice(-1024 * 1024)
      buf += String(d)
      let i
      while ((i = buf.indexOf('\n')) >= 0) {
        jobLine(job, buf.slice(0, i))
        buf = buf.slice(i + 1)
      }
    }
    child.stdout.on('data', onChunk)
    child.stderr.on('data', onChunk)
    child.on('error', (e) => finish(127, '执行失败: ' + e.message))
    child.on('close', (c) => finish(timedOut ? 124 : (typeof c === 'number' ? c : 1), acc))
    let timer = null
    if (opts.timeoutMs) {
      timer = setTimeout(() => {
        timedOut = true
        jobLine(job, '⚠ 超时 ' + Math.round(opts.timeoutMs / 1000) + ' 秒，SIGTERM 停止（3 秒后强杀）')
        try { child.kill('SIGTERM') } catch {}
        setTimeout(() => { try { child.kill('SIGKILL') } catch {} }, 3000)
      }, opts.timeoutMs)
    }
  })
}

/** 端口探测：任何 HTTP 应答都算活着（401 也算 —— 服务在，只是没登录）。 */
function waitUp(host, port, timeoutMs) {
  return new Promise((resolve) => {
    const t0 = Date.now()
    const probe = () => {
      const req = http.request({ host, port, path: '/', method: 'GET', timeout: 3000 },
        (res) => { res.resume(); resolve(true) })
      const again = () => {
        if (Date.now() - t0 > timeoutMs) return resolve(false)
        setTimeout(probe, 3000)
      }
      req.on('error', again)
      req.on('timeout', () => { req.destroy(); again() })
      req.end()
    }
    probe()
  })
}

/* ------------------------------------------------------------------ 鉴权 */

/** 把请求原样探到 dsh 的 /api 上：404=围栏+鉴权都过；401=未登录；403=围栏拒绝。 */
function probeAuth(hostHeader, cookie, path) {
  return new Promise((resolve) => {
    const headers = { host: hostHeader }
    if (cookie) headers.cookie = cookie
    const req = http.request(
      { host: UP_HOST, port: UP_PORT, path: path || '/api/__ctl_probe', method: 'GET', headers, timeout: 8000 },
      (res) => { res.resume(); resolve(res.statusCode) },
    )
    req.on('error', () => resolve(0))
    req.on('timeout', () => { req.destroy(); resolve(0) })
    req.end()
  })
}

/* ------------------------------------------------------------------ 控制台 API */

async function buildState(authed) {
  const sc = readSites()
  const creds = readCredentials()
  const ip = lanIp()
  const token = await readToken()
  const ver = await readVersion()
  const tokPart = /token=([A-Za-z0-9_-]+)/.exec(token)
 return {
  ok: true,
  services: readServices(),
   // 网关优先：dsh 没装时面板的版本行会提示「重跑安装脚本」
   dshMissing: !fs.existsSync(DSH_PKG_JSON),
   // 卸载脚本随网关下发：在场才给「卸载」按钮（apiUninstall 的前提）
   uninstallAvailable: fs.existsSync(UNINSTALL_SH),
  dshVersion: ver,
   nodeVersion: process.version,
    host: os.hostname(),
    lanIp: ip,
    gatewayUrl: ip ? 'http://' + ip + ':' + LISTEN_PORT + '/' : '',
    dshUrl: ip && tokPart ? 'http://' + ip + ':' + LISTEN_PORT + '/app?token=' + tokPart[1] : token,
    directUrl: token,
    sites: sc.sites,
    active: sc.active,
    migrated: sc.migrated,
    // 路由器模型：state 不登录也能取，明文 key 就不能跟着出去 —— 只给掩码；
    // 面板列表里那一列本来就是掩码，要增改密钥得登录走 save
    credentials: authed ? creds : creds.map((c) => ({ name: c.name, masked: c.masked })),
    presets: PRESETS,
    dshFlavor: {
      patcher: fs.existsSync(PATCHER),
      flockOk: flockNativeOk(),
      // 0.2.0+ 的 koffi 没有 android-arm64 预编译包，装的时候要 CMake 现编。
      // 先把这个位报出来，省得用户点了升级才发现缺工具。
      cmake: fs.existsSync(BIN + '/cmake'),
      ninja: fs.existsSync(BIN + '/ninja'),
      share: SHARE,
    },
    paths: { dshHome: DSH_HOME, keys: KEYS, serviceDir: SVD, sites: SITES_JSON, accounts: ACCOUNTS_JSON },
  }
}

/**
 * 新增接口时的固定预设。只有端点三要素（协议 / baseURL / 备注提示），
 * 模型一律去端点上真拉 —— 各家改名太快，预置写死的东西第二天就过时。
 *
 * kind=fixed 是「固定内置」组：本地/自建聚合路由，一个入口打通一堆 provider，
 * 这类端点在同一条隧道里反复用，所以做成开箱即用的一档。
 */
const PRESETS = [
  {
    kind: 'fixed', id: 'freellmapi', label: 'FreeLLMAPI 本地聚合',
    url: 'http://127.0.0.1:3001/v1', api: 'openai-completions', models: ['auto'], note: '本地聚合',
    hint: '自建聚合路由：各家免费 provider 的 key 填在它自己的面板里，对外只暴露一个 freellmapi- 开头的统一 key，模型写 auto 让它自己挑。默认监听 3001。',
  },
  {
    kind: 'fixed', id: 'freellm', label: 'FreeLLM (npx)',
    url: 'http://localhost:3000/v1', api: 'openai-completions', models: ['auto'], note: '本地聚合',
    hint: 'npx freellm 起的聚合网关，默认 3000，统一 key 形如 freellm-…，模型 auto。',
  },
  {
    kind: 'fixed', id: 'ollama', label: 'Ollama 本地',
    url: 'http://127.0.0.1:11434/v1', api: 'openai-completions', note: 'Ollama',
    hint: '本机 Ollama 的 OpenAI 兼容层，key 随便填（如 ollama），模型写 ollama list 里的名字。',
  },
  {
    kind: 'fixed', id: 'lmstudio', label: 'LM Studio 本地',
